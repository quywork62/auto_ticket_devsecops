# DefectDojo - backend pulls findings from this API.
DEFECTDOJO_BASE_URL=https://defectdojo.example.com
DEFECTDOJO_API_TOKEN=replace-with-defectdojo-token
DEFECTDOJO_FINDINGS_LIMIT=100

# Scheduler
SCHEDULER_INTERVAL_SECONDS=180
NOTIFICATION_LEASE_TTL_SECONDS=1800

# Database inside docker-compose network.
DATABASE_URL=postgresql+psycopg://devsecops_app:replace-with-postgres-password@postgres:5432/auto_ticket

# Project -> recipient mapping.
PROJECT_EMAIL_MAPPING_FILE=config/project_mapping.json

# SMTP sender for ticket and notification emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=DevSecOps Automation <sender@example.com>
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_EMAILS_PER_MINUTE=30
SMTP_MAX_EMAILS_PER_HOUR=500
SMTP_MAX_ATTEMPTS=3
SMTP_RETRY_DELAY_SECONDS=60
SMTP_RETRY_BACKOFF_MULTIPLIER=2
